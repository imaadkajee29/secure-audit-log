# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# SQLite file path. Use ":memory:" for an ephemeral store.
DB_PATH=./data/audit.db

# Both secrets must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
AUDIT_HMAC_KEY=change-me-to-a-different-long-random-string-32-plus

JWT_ISSUER=secure-audit-log
JWT_AUDIENCE=secure-audit-log-api

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Set true only when running behind a reverse proxy / ingress you control.
TRUST_PROXY=false

# Serve Swagger UI at /docs
ENABLE_DOCS=true
